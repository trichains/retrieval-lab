{
  "name": "retrieval-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A search and RAG laboratory: compare chunking, BM25, vector and hybrid retrieval, and measure them with recall@k, MRR and nDCG. Runs fully offline, no API key.",
  "author": "Cristhian Almeida",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trichains/retrieval-lab.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3120",
    "build": "next build",
    "start": "next start -p 3120",
    "lint": "eslint --max-warnings 0 && prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "rlab": "tsx src/cli/main.ts",
    "bench": "tsx scripts/bench.ts",
    "dataset:build": "tsx scripts/build-dataset.ts",
    "experiment": "tsx src/cli/main.ts eval --dataset datasets/nimbus.json --grid datasets/grid.default.json --out reports/nimbus --format md,json,csv,html",
    "screenshots": "tsx scripts/screenshots.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
